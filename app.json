{
  "expo": {
    "name": "Sooqly",
    "slug": "sooqly",
    "owner": "yanis83200",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sooqly",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sooqly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B2D22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sooqly.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B2D22",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C4512E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0c180a1d-1e17-40fa-9408-92fac9dde03e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0c180a1d-1e17-40fa-9408-92fac9dde03e"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
